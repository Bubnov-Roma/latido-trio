---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Logo from '../components/Logo.astro'
import Player from '../components/Player.astro'

interface Props {
  title?: string;
}
const { title = 'Latido Trio' } = Astro.props;

const _base = import.meta.env.BASE_URL;
const base = _base.endsWith('/') ? _base : _base + '/';
const url = (p: string) => (p.startsWith('/') ? base + p.slice(1) : p);

const allTracks = await getCollection('tracks');
const tracks = allTracks.sort((a, b) => a.data.order - b.data.order);

const nav = [
  { href: base, label: 'Главная' },
  { href: url('/bio'), label: 'О нас' },
  { href: `${base}#shows`, label: 'Концерты' },
  { href: url('/media'), label: 'Медиа' },
  { href: url('/news'), label: 'Новости' },
  { href: url('/contacts'), label: 'Контакты' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === base ? currentPath === base || currentPath === base.slice(0, -1) : currentPath.startsWith(href.split('#')[0]) && href !== `${base}#shows`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content="Официальный сайт группы Latido Trio" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,600&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" href={url('/favicon-96x96.png')} sizes="96x96" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <meta name="theme-color" content="#2B2B2A" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a href={url('/')} class="brand">
        <Logo variant="vertical" size="3rem"  class="blend-layer" />
      </a>

      <button class="listen-btn blend-layer" id="listen-btn" type="button">Слушать</button>


      <div class="header-actions">
        <div class="nav-wrap">
          <button
            class="icon-btn burger blend-layer"
            id="menu-toggle"
            type="button"
            aria-label="Открыть меню"
            aria-expanded="false"
            aria-controls="nav-panel"
          >
            <span class="menu-line l1"></span>
            <span class="menu-line l2"></span>
          </button>
        </div>
      </div>
    </header>
    <nav class="nav-panel" id="nav-panel" aria-label="Основная навигация">
      {nav.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>{item.label}</a>
      ))}
      <div class="nav-panel-footer">…</div>
    </nav>


    <Player tracks={tracks} />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} Latido Trio · <a href={url('/admin')}>Панель управления</a>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const setMenu = (open) => {
          document.body.classList.toggle('menu-open', open);
          const t = document.getElementById('menu-toggle');
          if (t) {
            t.setAttribute('aria-expanded', String(open));
            t.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
          }
        };

        if (window.__navInit) return;
        window.__navInit = true;

        document.addEventListener('click', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          if (t.closest('#menu-toggle')) {
            setMenu(!document.body.classList.contains('menu-open'));
          } else if (t.closest('.nav-panel a')) {
            setMenu(false);
          } else if (!t.closest('.nav-panel')) {
            setMenu(false);
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setMenu(false);
        });

        document.addEventListener('astro:page-load', () => setMenu(false));

        document.addEventListener('click', (e) => {
          const t = e.target;
          if (t instanceof Element && t.closest('#listen-btn')) {
            document.getElementById('p-play')?.click();
          }
        });
      })();
    </script>
  </body>
</html>