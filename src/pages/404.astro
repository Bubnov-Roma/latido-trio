---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

const _base = import.meta.env.BASE_URL;
const base = _base.endsWith('/') ? _base : _base + '/';
const url = (p: string) => (p.startsWith('/') ? base + p.slice(1) : p);

const heroImg = fs.existsSync('public/uploads/img/404.jpg')
  ? `${base}uploads/img/404.jpg`
  : '';
---

<Base title="Страница не найдена — Latido Trio">
  <section class="nf-page" style={`--nf-img: url('${heroImg}')`}>
    <div class="nf-inner">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1 class="nf-title">Страница не найдена</h1>
      <p class="nf-text">
        Похоже, такой страницы не существует — возможно, ссылка устарела
        или адрес набран с ошибкой.
      </p>
      <div class="nf-actions">
        <a href={url('/')} class="btn">На главную</a>
      </div>
    </div>
  </section>
</Base>