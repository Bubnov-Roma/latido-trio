---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const _base = import.meta.env.BASE_URL;
const base = _base.endsWith('/') ? _base : _base + '/';
const url = (p: string) => (p.startsWith('/') ? base + p.slice(1) : p);

const now = new Date();
const upcoming = (await getCollection('shows'))
  .filter((s) => s.data.date >= now && s.data.status !== 'cancelled')
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const latestNews = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const tracks = (await getCollection('tracks')).sort((a, b) => a.data.order - b.data.order);

const members = (await getCollection('members'))
  .slice()
  .sort((a, b) => a.data.order - b.data.order);

const MONTHS = ['янв', 'фев', 'мар', 'апр', 'мая', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'];
const MONTHS_FULL = ['ЯНВАРЯ', 'ФЕВРАЛЯ', 'МАРТА', 'АПРЕЛЯ', 'МАЯ', 'ИЮНЯ', 'ИЮЛЯ', 'АВГУСТА', 'СЕНТЯБРЯ', 'ОКТЯБРЯ', 'НОЯБРЯ', 'ДЕКАБРЯ'];

const showsData = upcoming.map((s) => ({
  title: s.data.title ?? s.data.city,
  city: s.data.city,
  venue: s.data.venue,
  dateLabel: `${s.data.date.getDate()} ${MONTHS_FULL[s.data.date.getMonth()]} ${s.data.date.getFullYear()}`,
  time: s.data.time ?? '',
  description: s.data.description ?? '',
  status: s.data.status ?? 'active',
  ticketUrl: s.data.ticketUrl ?? '',
}));

const heroVars: string[] = [];
const addHeroImage = (varName: string, file: string) => {
  if (fs.existsSync(`public/uploads/img/${file}`)) {
    heroVars.push(`--${varName}: url('${base}uploads/img/${file}')`);
  }
};
addHeroImage('hero-image', 'hero.jpg');
addHeroImage('hero-image-light', 'hero-light.jpg');
addHeroImage('hero-image-tablet', 'hero-tablet.jpg');
addHeroImage('hero-image-tablet-light', 'hero-tablet-light.jpg');
addHeroImage('hero-image-mobile', 'hero-mobile.jpg');
addHeroImage('hero-image-mobile-light', 'hero-mobile-light.jpg');

const heroStyle = [...heroVars, '--hero-image-position: center'].join('; ');

const initials = (name: string) =>
  name.split(/\s+/).map((w) => w[0] ?? '').join('').slice(0, 2).toUpperCase();
---

<Base>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <section class="hero" style={heroStyle}>
    <div class="hero-content">
      <Logo variant="horizontal" size="clamp(8rem, 7rem + 4vw, 12rem)" />
      <h1>Три сердца — один ритм</h1>

      <div class="hero-actions">
        <a href={url('/bio')} class="btn">Познакомиться</a>
        <a href={`${base}#shows`} class="btn btn-outline">Афиша концертов</a>
      </div>

      <div class="socials">
        <a href="https://vk.ru/latido_trio_samara" aria-label="ВКонтакте">VK</a>
        <a href="#" aria-label="Telegram">TG</a>
        <a href="#" aria-label="YouTube">YT</a>
      </div>
    </div>
  </section>

  <div class="container main-content-container">

    <section id="shows" class="content-section">
      <div class="section-header">
        <h2 class="section-title">Концерты</h2>
        <span class="section-subtitle-count">{upcoming.length} событий</span>
      </div>

      {upcoming.length === 0 && (
        <div class="empty-card">
          <p>Новые концерты скоро будут анонсированы. Следите за обновлениями!</p>
        </div>
      )}

      <ul class="show-list">
        {upcoming.map((show, i) => (
          <li>
            <button type="button" class="show-item" data-show-index={i}>
              <span class="show-date">
                <span class="mon">{MONTHS[show.data.date.getMonth()]}</span>
                <span class="day">{show.data.date.getDate()}</span>
                <span class="yr">{show.data.date.getFullYear()}</span>
              </span>
              <span class="show-info">
                <span class="show-city">
                  {show.data.title ?? show.data.city}
                  {show.data.status === 'soldout' && <span class="badge">Sold out</span>}
                </span>
                <span class="show-venue">
                  {show.data.title
                    ? `${show.data.venue} · ${show.data.city}`
                    : show.data.venue}
                </span>
              </span>
              <span class="show-details">
                Детали
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </section>

    {members.length > 0 && (
      <section class="content-section">
        <div class="section-header">
          <h2 class="section-title">Состав</h2>
          <a href={url('/bio')} class="section-link">Весь коллектив →</a>
        </div>

        <div class="members-teaser-grid">
          {members.map((m, i) => (
            <a class="member-teaser" href={url('/bio')}  style={`--i: ${i}`}>
              {m.data.photoHome ? (
                <img src={url(m.data.photoHome)} alt={m.data.name} loading="lazy" decoding="async" />
              ) : (
                <div class="member-teaser-empty" aria-hidden="true">{initials(m.data.name)}</div>
              )}
              <span class="member-teaser-caption">
                <span class="mt-name">{m.data.name}</span>
                <span class="mt-role">{m.data.role}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="content-section">
      <div class="section-header">
        <h2 class="section-title">Слушать музыку</h2>
        <a href={url('/media')} class="section-link">Все треки →</a>
      </div>

      {tracks.length === 0 && (
        <div class="empty-card">
          <p>Треки появятся здесь. Добавляйте их через панель управления.</p>
        </div>
      )}

      <div class="tracks-grid">
        {tracks.map((t, i) => (
          <div class="track-card card">
            <button class="track-play-btn" data-play-track={i} aria-label={'Слушать: ' + t.data.title}>
              <svg class="ic-play" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              <svg class="ic-pause" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" style="display:none"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
            </button>
            <div class="track-card-info">
              <span class="track-number">{(i + 1).toString().padStart(2, '0')}</span>
              <span class="track-title">{t.data.title}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-header">
        <h2 class="section-title">Новости и события</h2>
        <a href={url('/news')} class="section-link">Все новости →</a>
      </div>

      <div class="news-grid">
        {latestNews.map((item) => (
          <article class="news-card card">
            {item.data.cover && (
              <div class="news-img-wrap">
                <img src={item.data.cover.src} alt={item.data.title} loading="lazy" />
              </div>
            )}
            <div class="pad">
              <time datetime={item.data.date.toISOString()}>
                {item.data.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              <h3>{item.data.title}</h3>
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>

  <div class="show-modal" id="show-modal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="show-modal-scrim" data-close></div>
    <div class="show-modal-panel">
      <button class="icon-btn show-modal-close" data-close aria-label="Закрыть">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
          <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <div class="sm-date" id="sm-date"></div>
      <h3 class="sm-title" id="sm-title"></h3>
      <div class="sm-meta" id="sm-meta"></div>
      <p class="sm-desc" id="sm-desc"></p>
      <div class="sm-actions" id="sm-actions"></div>
    </div>
  </div>

  <script type="application/json" id="shows-data" set:html={JSON.stringify(showsData)}></script>

  <script>
    const teaserIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            teaserIO.unobserve(e.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    document.querySelectorAll('.member-teaser').forEach((el) => teaserIO.observe(el));

    const modal = document.getElementById('show-modal');
    const dataEl = document.getElementById('shows-data');

    if (modal && dataEl) {
      const shows: any[] = JSON.parse(dataEl.textContent || '[]');

      const $ = (id: string) => document.getElementById(id);
      let lastFocus: Element | null = null;

      const openShow = (i: number) => {
        const s = shows[i];
        if (!s) return;
        $('sm-date')!.textContent = s.time ? `${s.dateLabel} · ${s.time}` : s.dateLabel;
        $('sm-title')!.textContent = s.title;
        $('sm-meta')!.textContent = `${s.venue} · ${s.city}`;

        const desc = $('sm-desc')!;
        desc.textContent = s.description;
        desc.style.display = s.description ? '' : 'none';

        const actions = $('sm-actions')!;
        if (s.status === 'soldout') {
          actions.innerHTML = '<span class="btn btn-disabled">Билеты закончились</span>';
        } else if (s.ticketUrl) {
          actions.innerHTML = `<a class="btn" href="${s.ticketUrl}" target="_blank" rel="noopener">Купить билет</a>`;
        } else {
          actions.innerHTML = '';
        }

        lastFocus = document.activeElement;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        (modal.querySelector('.show-modal-close') as HTMLElement | null)?.focus();
      };

      const closeShow = () => {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        (lastFocus as HTMLElement | null)?.focus?.();
      };

      document.querySelectorAll('[data-show-index]').forEach((el) => {
        el.addEventListener('click', () => openShow(Number((el as HTMLElement).dataset.showIndex)));
      });
      modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeShow));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) closeShow();
      });
    }
  </script>
</Base>